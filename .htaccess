Options -Indexes

<FilesMatch "(?i)^(config(?:\.example)?\.php|ai\.example\.php|.*\.(?:sql|md|env|log))$">
    Require all denied
</FilesMatch>

RedirectMatch 403 /(?:docs|includes|tools|uploads|vendor|tmp|jamaat-helpdesk|\.git)(?:/|$)

<FilesMatch "^composer\.(?:json|lock)$">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)\.local\.php$">
    Require all denied
</FilesMatch>
